{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "types": ["expo/types/global"],
    "strict": true,
    "jsx": "react-native",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "components/CustomButton.jsx",
    "components/CustomInput.jsx",
    "app/confirmation.jsx"
  ],
  "files": []
}
